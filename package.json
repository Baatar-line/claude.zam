{
  "name": "zam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "seed": "bun run prisma/seed/index.ts",
    "seed:check": "bun run prisma/seed/index.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.120.0",
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "6.19.3",
    "next": "15.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.22.0",
    "server-only": "0.0.1",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
