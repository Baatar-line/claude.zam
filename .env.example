# ---------------------------------------------------------------------------
# Зам — environment
# Copy to .env and fill in. lib/env.ts validates this at boot and refuses to
# start on a missing required value, so a half-configured deploy never serves.
# ---------------------------------------------------------------------------

# REQUIRED --------------------------------------------------------------------

# Postgres. Neon in production, a local cluster in development.
DATABASE_URL="postgresql://zam:zam@127.0.0.1:5432/zam"

# Read by schema.prisma as `directUrl`, used by `prisma migrate`. On Neon this
# is the unpooled connection, because the pooled one cannot run DDL. Locally
# it is the same string as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://zam:zam@127.0.0.1:5432/zam"

# Signs the anonymous session cookie. 32+ characters.
#   openssl rand -base64 32
SESSION_SECRET="replace-me-with-at-least-32-characters-of-random"

# OPTIONAL --------------------------------------------------------------------

# "neon" | "local". Unset = inferred from the DATABASE_URL host.
# DB_ADAPTER="local"

# AI narrative layer (§6). ABSENT IS A SUPPORTED STATE: with no key, the
# result page still renders every score, band and career correctly and falls
# back to deterministic template prose.
# ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"

# Parent report delivery only. Absent = the email feature is off.
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="tailan@zam.mn"

APP_URL="http://localhost:3000"
